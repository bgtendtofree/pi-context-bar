{
	"name": "pi-context-bar",
	"version": "0.1.0",
	"description": "Rounded Pi editor with Pac-Man context health, cache hit, and cost.",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"pi-package",
		"pi",
		"context",
		"status-bar",
		"tui"
	],
	"files": [
		"index.ts",
		"lib/border.ts",
		"lib/chrome.ts",
		"lib/config.ts",
		"lib/context.ts",
		"lib/header.ts",
		"lib/kimi.ts",
		"lib/openai.ts",
		"lib/openrouter.ts",
		"lib/speed.ts",
		"ui/rounded-editor.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"quality": "biome ci .",
		"test": "node --test",
		"test:coverage": "rm -rf coverage && mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='lib/*.ts' --test-coverage-exclude='lib/*.test.ts' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
		"smoke:package": "node scripts/smoke-package.mjs",
		"validate": "npm run quality && npm run typecheck && npm test",
		"ci": "npm run quality && npm run typecheck && npm run test:coverage && npm run smoke:package"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@earendil-works/pi-coding-agent": "0.84.0",
		"@earendil-works/pi-tui": "0.84.0",
		"@types/node": "^24.0.0",
		"typescript": "7.0.2"
	}
}
