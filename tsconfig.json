{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": ".tsbuild/src",
		"tsBuildInfoFile": ".tsbuild/src.tsbuildinfo"
	},
	"include": ["index.ts", "commands/**/*.ts", "lib/**/*.ts", "ui/**/*.ts"],
	"exclude": ["coverage", "**/*.test.ts"]
}
