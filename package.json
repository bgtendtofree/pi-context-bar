{
	"name": "pi-context-bar",
	"version": "0.1.0",
	"description": "Open-sided Pi editor with Pac-Man context health, cache hit, and cost.",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"pi-package",
		"pi",
		"context",
		"status-bar",
		"tui"
	],
	"files": [
		"index.ts",
		"commands/openai-codex-reset.ts",
		"lib/billing.ts",
		"lib/border.ts",
		"lib/chrome.ts",
		"lib/config.ts",
		"lib/context-audit.ts",
		"lib/context.ts",
		"lib/header.ts",
		"lib/json.ts",
		"lib/openai.ts",
		"lib/pending-reset.ts",
		"lib/prompt.ts",
		"lib/quota.ts",
		"lib/response-quota.ts",
		"lib/speed.ts",
		"lib/stash.ts",
		"lib/status.ts",
		"lib/timing.ts",
		"ui/framed-editor.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc -b tsconfig.test.json",
		"quality": "biome ci .",
		"test": "node --test",
		"test:coverage": "rm -rf coverage && mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='commands/*.ts' --test-coverage-include='lib/*.ts' --test-coverage-include='ui/*.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
		"test:coverage:index": "node --test --experimental-test-coverage --test-coverage-include='index.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test-reporter=spec",
		"smoke:package": "node scripts/smoke-package.mjs",
		"smoke:tui": "python3 scripts/smoke-tui.py",
		"validate": "npm run quality && npm run typecheck && npm test",
		"ci": "npm run quality && npm run typecheck && npm run test:coverage && npm run test:coverage:index && npm run smoke:package && npm run smoke:tui"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^24.0.0",
		"typescript": "7.0.2"
	}
}
